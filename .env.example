# IFT Crew Mapper — environment variables
# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Google Maps JavaScript API key (needed for distance/travel time)
GOOGLE_MAPS_API_KEY=

# Base addresses used to compute drive time from base to first pickup
SAC_ADDRESS=123 Main St, Sacramento, CA 95814
SC_ADDRESS=456 Park Ave, Santa Clara, CA 95050

# Homebase integration (optional)
HB_TOKEN=
HB_SAC_UUID=
HB_SC_UUID=

# Zoho integration (optional)
ZOHO_API_URL=
ZOHO_API_TOKEN=
